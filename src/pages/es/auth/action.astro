---
import ModernLayout from '@/layouts/ModernLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import { AuthActionHandler } from '@/components/auth/AuthActionHandler';
import { getTranslations } from '@/i18n/translations';

// Target of Firebase Auth email links (password reset, email verification,
// email-change revert). Replaces secid-org.firebaseapp.com/__/auth/action;
// see docs/runbooks/prod-cutover.md §5.1 for the console step.
const t = getTranslations('es');
---

<ModernLayout
  title={`${t.auth.action.resetTitle} - ${t.site.name}`}
  description={t.auth.action.resetSubtitle}
  lang="es"
  noIndex={true}
>
  <Navigation lang="es" />
  <div
    class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8 dark:bg-gray-900"
  >
    <div class="w-full max-w-md">
      <AuthActionHandler client:only="react" lang="es" />
    </div>
  </div>
  <Footer lang="es" />
</ModernLayout>
